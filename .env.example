# HTTP-порт застосунку (обов'язковий)
PORT=3000
# Хост Postgres. localhost — коли Nest на машині, а БД у Docker
DB_HOST=localhost
# Порт Postgres
DB_PORT=5432
# Роль застосунку (не суперкористувач; пароль у secrets/db_password)
DB_USER=app_user
# Ім'я бази
DB_NAME=shop
# Рівень логів: debug | info | warn | error
LOG_LEVEL=info
# Таймаут у мілісекундах
TIMEOUT_MS=5000
