# HTTP-порт застосунку (обов'язковий)
PORT=3000
# Хост Postgres/PgBouncer. localhost — коли Nest на машині, а БД у Docker
DB_HOST=localhost
# Порт PgBouncer (не прямий Postgres)
DB_PORT=6432
# Роль застосунку (не суперкористувач)
DB_USER=app_user
# Пароль Postgres. TypeORM DataSource читає саме його (migrate/seed/demo/report).
# Nest HTTP-шар досі бере пароль з secrets/db_password (ДЗ #11).
# Живе значення — у Infisical (env dev), не комітити.
DB_PASSWORD=fake-password
# Ім'я бази
DB_NAME=shop
# Рядок підключення через PgBouncer (пароль фейковий). Живе значення — у сховищі
DB_URL=postgresql://app_user:fake-password@localhost:6432/shop
# AMQP-адреса RabbitMQ (порт 5672, не management 15672). Живе значення — у Infisical
BROKER_URL=amqp://USER:PASSWORD@127.0.0.1:5672
# Кеш Redis (maxmemory + allkeys-lru). Живе значення — у Infisical, не в git
REDIS_URL=redis://127.0.0.1:16379
# Черга BullMQ, сесії і rate-limit (noeviction). Окремий процес від кеша
REDIS_QUEUE_URL=redis://127.0.0.1:16380
# Рівень логів: debug | info | warn | error
LOG_LEVEL=info
# Таймаут у мілісекундах
TIMEOUT_MS=5000
# Ключ підпису access-токенів ES256: base64 від PKCS#8 PEM (EC P-256). Тільки зі сховища (Infisical)
JWT_PRIVATE_KEY=base64-pkcs8-pem-from-vault
# Публічна пара до ключа підпису: base64 від SPKI PEM. Зі сховища поруч із приватним
JWT_PUBLIC_KEY=base64-spki-pem-from-vault
# Ідентифікатор ключа (kid у заголовку JWT), міняється при кожній ротації ключа
JWT_KID=dev-2026-10
# «Перець» для HMAC хешів refresh-токенів, ≥ 32 символи. Тільки зі сховища
REFRESH_TOKEN_PEPPER=random-32-plus-characters-from-vault
