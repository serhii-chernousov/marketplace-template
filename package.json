{
  "name": "marketplace-template",
  "version": "1.0.0",
  "private": true,
  "description": "Marketplace API — OpenAPI contract + NestJS runtime validation (hw-09, variant B)",
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main.js",
    "start:vault": "bash scripts/with-secrets.sh dev npm run start",
    "start:dev": "nest start --watch",
    "start:worker": "npm run build && node dist/worker.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:openapi": "npx @redocly/cli@2.46.0 lint openapi/openapi.yaml",
    "bundle:openapi": "npx @redocly/cli@2.46.0 bundle openapi/openapi.yaml -o spec.json",
    "check:env": "node scripts/check-env-example.mjs",
    "migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
    "migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
    "demo:contour": "node scripts/contour-demo.mjs",
    "demo:realtime": "node scripts/realtime-demo.mjs",
    "demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo/demo-nplus1.js",
    "demo:race": "bash scripts/with-secrets.sh dev node dist/demo/demo-race.js",
    "demo:workers": "bash scripts/with-secrets.sh dev node dist/demo/demo-workers.js",
    "demo:retry": "bash scripts/with-secrets.sh dev node dist/demo/demo-retry.js",
    "demo:publish": "bash scripts/with-secrets.sh dev node dist/demo/demo-publish.js",
    "demo:dlq": "bash scripts/with-secrets.sh dev node dist/demo/demo-dlq.js",
    "demo:duplicate": "bash scripts/with-secrets.sh dev node dist/demo/demo-duplicate.js",
    "demo:outbox": "bash scripts/with-secrets.sh dev node dist/demo/demo-outbox.js",
    "demo:crash-write": "bash scripts/with-secrets.sh dev node dist/demo/demo-crash-write.js",
    "demo:crash-relay": "bash scripts/with-secrets.sh dev node dist/demo/demo-crash-relay.js",
    "demo:cache": "bash scripts/with-secrets.sh dev node dist/demo/demo-cache.js",
    "demo:session": "bash scripts/with-secrets.sh dev node dist/demo/demo-session.js",
    "demo:ratelimit": "bash scripts/with-secrets.sh dev node dist/demo/demo-ratelimit.js",
    "demo:queue": "bash scripts/with-secrets.sh dev node dist/demo/demo-queue.js",
    "demo:auth": "bash scripts/with-secrets.sh dev node dist/demo/demo-auth.js",
    "demo:reuse": "bash scripts/with-secrets.sh dev node dist/demo/demo-reuse.js",
    "demo:rbac": "bash scripts/with-secrets.sh dev node dist/demo/demo-rbac.js",
    "demo:upload": "bash scripts/with-secrets.sh dev node dist/demo/demo-upload.js",
    "demo:multipart": "bash scripts/with-secrets.sh dev node dist/demo/demo-multipart.js",
    "demo:cdn": "bash scripts/with-secrets.sh dev node dist/demo/demo-cdn.js",
    "demo:logs": "bash scripts/with-secrets.sh dev node dist/demo/demo-logs.js",
    "demo:metrics": "bash scripts/with-secrets.sh dev node dist/demo/demo-metrics.js",
    "demo:trace": "bash scripts/with-secrets.sh dev node dist/demo/demo-trace.js",
    "report": "bash scripts/with-secrets.sh dev node dist/report.js",
    "test:unit": "jest --config jest.config.js --testPathPatterns=src/",
    "test:integration": "jest --config jest.config.js --testPathPatterns=test/integration --runInBand",
    "test:e2e": "jest --config jest.config.js --testPathPatterns=test/e2e --runInBand",
    "test:contract": "jest --config jest.config.js --testPathPatterns=test/contract/consumer --runInBand",
    "verify:provider": "jest --config jest.config.js --testPathPatterns=test/contract/provider --runInBand",
    "image:build": "bash scripts/image-build.sh",
    "scan": "node scripts/scan.mjs",
    "gate:types": "tsc --noEmit -p tsconfig.spec.json && eslint src test",
    "gate:contract": "bash scripts/gates/contract.sh",
    "gate:arch": "depcruise src --config .dependency-cruiser.cjs",
    "gate:cost": "tsx scripts/cost-gate.ts",
    "demo:gates": "bash scripts/demo-gates.sh",
    "demo:oidc": "node scripts/demo-oidc.mjs",
    "cluster:up": "bash scripts/cluster-up.sh",
    "cluster:down": "kind delete cluster --name hw28",
    "up": "bash scripts/with-secrets.sh dev bash scripts/deploy.sh",
    "platform:up": "bash scripts/with-secrets.sh dev bash scripts/pulumi.sh platform up --yes",
    "destroy": "bash scripts/with-secrets.sh dev bash scripts/destroy.sh",
    "demo:image": "bash demo/image.sh",
    "demo:rollout": "bash scripts/with-secrets.sh dev bash demo/rollout.sh",
    "demo:pdb": "bash demo/pdb.sh",
    "demo:platform-blip": "bash demo/platform-blip.sh",
    "up:base": "bash scripts/with-secrets.sh dev bash scripts/pulumi-aws.sh base up --yes",
    "up:demo": "bash scripts/with-secrets.sh dev bash scripts/pulumi-aws.sh demo up --yes",
    "destroy:demo": "bash scripts/with-secrets.sh dev bash scripts/pulumi-aws.sh demo destroy --yes",
    "destroy:base": "bash scripts/with-secrets.sh dev bash scripts/pulumi-aws.sh base destroy --yes",
    "demo:failover": "bash scripts/with-secrets.sh dev bash demo/aws-failover.sh",
    "demo:alb": "bash scripts/with-secrets.sh dev bash demo/aws-alb.sh",
    "demo:nat": "bash scripts/with-secrets.sh dev bash demo/aws-nat.sh",
    "evidence:base": "bash scripts/with-secrets.sh dev bash scripts/aws/evidence-base.sh",
    "evidence:iam": "bash scripts/with-secrets.sh dev bash scripts/aws/evidence-iam.sh",
    "evidence:prices": "bash scripts/with-secrets.sh dev bash scripts/aws/prices.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "~4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "amqplib": "^2.2.0",
    "bullmq": "^6.5.0",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typeorm": "^0.3.31",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.7",
    "@pact-foundation/pact": "^17.1.4",
    "@redocly/cli": "2.46.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "18.9.0",
    "dotenv": "^16.6.1",
    "eslint": "10.15.0",
    "jest": "^30.5.2",
    "jose": "6.2.18",
    "prettier": "^3.9.6",
    "supertest": "^7.3.0",
    "testcontainers": "^12.2.0",
    "ts-jest": "^29.4.14",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.74.0"
  }
}
