{
	"name": "marketplace-template",
	"version": "1.0.0",
	"private": true,
	"description": "Marketplace API — OpenAPI contract + NestJS runtime validation (hw-09, variant B)",
	"scripts": {
		"build": "nest build",
		"start": "npm run build && node dist/main.js",
		"start:dev": "nest start --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:openapi": "npx @redocly/cli@2.46.0 lint openapi/openapi.yaml",
		"bundle:openapi": "npx @redocly/cli@2.46.0 bundle openapi/openapi.yaml -o spec.json",
		"check:env": "node scripts/check-env-example.mjs",
		"migrate": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
		"migrate:show": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:show -d dist/database/data-source.js",
		"migrate:revert": "bash scripts/with-secrets.sh dev node ./node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
		"seed": "bash scripts/with-secrets.sh dev node dist/seed.js",
		"demo:nplus1": "bash scripts/with-secrets.sh dev node dist/demo/demo-nplus1.js",
		"demo:race": "bash scripts/with-secrets.sh dev node dist/demo/demo-race.js",
		"demo:workers": "bash scripts/with-secrets.sh dev node dist/demo/demo-workers.js",
		"demo:retry": "bash scripts/with-secrets.sh dev node dist/demo/demo-retry.js",
		"report": "bash scripts/with-secrets.sh dev node dist/report.js",
		"test:integration": "jest --config jest.config.js --testPathPatterns=test/integration --runInBand",
		"test:e2e": "jest --config jest.config.js --testPathPatterns=test/e2e --runInBand",
		"test:contract": "jest --config jest.config.js --testPathPatterns=test/contract/consumer --runInBand",
		"verify:provider": "jest --config jest.config.js --testPathPatterns=test/contract/provider --runInBand"
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@nestjs/common": "^11.1.6",
		"@nestjs/config": "~4.0.2",
		"@nestjs/core": "^11.1.6",
		"@nestjs/platform-express": "^11.1.6",
		"@nestjs/platform-socket.io": "^11.2.7",
		"@nestjs/websockets": "^11.2.7",
		"express": "4.22.2",
		"express-openapi-validator": "5.6.2",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"typeorm": "^0.3.31",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.10",
		"@nestjs/testing": "^11.2.7",
		"@pact-foundation/pact": "^17.1.4",
		"@redocly/cli": "2.46.0",
		"@testcontainers/postgresql": "^12.2.0",
		"@types/express": "^4.17.23",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.17.2",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"dotenv": "^16.6.1",
		"jest": "^30.5.2",
		"prettier": "^3.9.6",
		"supertest": "^7.3.0",
		"testcontainers": "^12.2.0",
		"ts-jest": "^29.4.14",
		"typescript": "^5.9.2"
	}
}
